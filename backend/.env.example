# Copy this file to ".env" and fill in your own values.
# .env is excluded from Git (see the project-root .gitignore).
# NEVER commit a real API key, and never paste one into chat.

# Groq API key (get one from https://console.groq.com). Required from
# Milestone 4 onward; the backend runs without it in Milestone 1.
GROQ_API_KEY=

# Groq model ID to use for the agent loop. Must support tool calling.
# Recommended (verified October 2026): llama-3.3-70b-versatile is
# Groq's tool-calling model. The Groq catalogue changes over time —
# check https://console.groq.com/docs/models and set any tool-calling
# model here; the backend does not hardcode one.
# GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MODEL=

# Docker sandbox policy (Milestone 3). Optional — the defaults shown
# here are what the backend uses when these are unset. The sandbox
# image is built from sandbox/Dockerfile:
#   docker build -t autonomous-sandbox-agent:latest sandbox/
# SANDBOX_IMAGE=autonomous-sandbox-agent:latest
# SANDBOX_MEMORY=256m
# SANDBOX_CPUS=0.5
# SANDBOX_PIDS_LIMIT=64
# SANDBOX_TIMEOUT_SECONDS=30

# Web search provider (Milestone 6). DuckDuckGo needs no API key and
# is the default. Tavily is optional and requires its own key; if it
# is selected without a key, web_search returns an honest error
# instead of searching.
# SEARCH_PROVIDER=duckduckgo
# TAVILY_API_KEY=
# SEARCH_MAX_RESULTS=5

# Frontend CORS origins (Milestone 7). Comma-separated list of origins
# the React frontend may call this API from. The defaults (shown here)
# cover the Vite dev server; change only if you serve the frontend
# from somewhere else locally.
# FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Reliability (Milestone 8). MAX_CONCURRENT_TASKS caps how many agent
# tasks run at once; extra tasks wait "queued" and start in order.
# LOG_LEVEL sets the backend log level (DEBUG/INFO/WARNING/ERROR).
# Logs record task ids, tool names and statuses only — never the API
# key or file contents.
# MAX_CONCURRENT_TASKS=2
# LOG_LEVEL=INFO
