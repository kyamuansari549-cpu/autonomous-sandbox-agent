# Copy this file to ".env" and fill in your own values.
# .env is excluded from Git (see the project-root .gitignore).
# NEVER commit a real API key, and never paste one into chat.

# Groq API key (get one from https://console.groq.com). Required from
# Milestone 4 onward; the backend runs without it in Milestone 1.
GROQ_API_KEY=

# Groq model ID to use for the agent loop. Leave empty to use the
# backend default selection; must support tool calling.
GROQ_MODEL=
